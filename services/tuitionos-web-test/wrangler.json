{
  "name": "tuitionos-web-test",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "../../dist/server/index.js",
  "assets": {
    "directory": "../../dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tuitionos-web-test-db",
      "database_id": "3d34a796-93f7-44cf-8f5f-33ef2ee77994"
    }
  ],
  "services": [
    {
      "binding": "AI_JOB_SERVICE",
      "service": "tuitionos-ai-jobs-staging"
    }
  ],
  "vars": {
    "AI_JOB_SERVICE_URL": "https://tuitionos-ai-jobs-staging.nextgenn-ai.workers.dev"
  }
}
